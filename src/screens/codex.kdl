// The bestiary (the codex): every enemy in content/enemies.kdl with its glyph and what it does.
prefab "codex" {
    panel class="shared-scrim codex" {
        panel class="codex-head" {
            panel class="codex-back" slot="back"
            text class="codex-title" "BESTIARY"
        }
        panel class="codex-grid" slot="cards"
    }
}
