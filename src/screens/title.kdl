// The title over the attract-mode arena.
prefab "title" {
    panel class="title" {
        panel class="title-scrim"
        panel class="logo" {
            text class="logo-kicker" "LIORA LABS PRESENTS"
            text class="logo-word" "GRAVEWAKE"
            text class="logo-tag" "THE DEAD DO NOT STAY BURIED"
        }
        panel class="title-buttons" slot="buttons"
        text class="title-best" bind="best"
        text class="title-hint" bind="hint"
        panel class="title-credit" tap="credit" {
            text class="title-credit-text" "VIBECODED BY LIORA LABS  ·  READ HOW IT WAS MADE"
        }
    }
}
