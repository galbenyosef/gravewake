// The run is over: score, records, retry.
prefab "gameover" {
    panel class="shared-scrim gameover" {
        text class="go-title" "YOU HAVE FALLEN"
        text class="go-score" bind="score"
        text class="go-best" bind-class="bestState" bind="best"
        panel class="go-stats" {
            text class="go-stat" bind="wave"
            text class="go-stat" bind="kills"
        }
        panel class="go-buttons" slot="buttons"
    }
}
