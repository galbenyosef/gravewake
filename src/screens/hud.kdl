// In-fight heads-up display: vigour and score top-left, wave and boss bar top-centre, multiplier and pause top-right,
// and a centre banner for wave starts and clears.
prefab "hud" {
    panel class="hud" {
        panel class="hud-top" {
            panel class="hud-left" {
                pips class="vigour" count=(bind)"maxHp" value=(bind)"hp"
                text class="score" bind="score"
            }
            panel class="hud-mid" {
                text class="wave" bind="wave"
                panel class="boss" slot="boss"
            }
            panel class="hud-right" {
                text class="mult" bind-class="multState" bind="mult"
                button class="pause-btn" tap="pause" {
                    text class="pause-glyph" "II"
                }
            }
        }
        panel class="banner" if="banner" key=(bind)"bannerKey" {
            text class="banner-kicker" bind="bannerKicker"
            text class="banner-title" bind="banner"
        }
        panel class="hurt-flash" bind-class="hurt"
    }
}
