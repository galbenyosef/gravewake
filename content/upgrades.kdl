// Between waves the player picks one of these. Effect words and what they do are in src/upgrades.ts.

upgrade "overclock" name="Overclock" icon="RoF" blurb="Fire rate +25%" {
    fire-rate 1.25
}
upgrade "hollow-point" name="Hollow Point" icon="DMG" blurb="Damage +30%" {
    damage 1.3
}
upgrade "split-barrel" name="Split Barrel" icon="x2" blurb="One more barrel, fanned" {
    barrels 1
}
upgrade "lance" name="Lance Rounds" icon="PRC" blurb="Shots pierce one more enemy" {
    pierce 1
}
upgrade "afterburner" name="Afterburner" icon="SPD" blurb="Move speed +15%" {
    thrust 1.15
}
upgrade "plating" name="Plating" icon="HP" blurb="+1 hull, fully repaired" {
    hull 1
}
upgrade "tractor" name="Tractor Field" icon="MAG" blurb="Shard pull range +60%" {
    magnet 1.6
}
upgrade "railgun" name="Rail Coils" icon="VEL" blurb="Shot speed +25%, damage +10%" {
    shot-speed 1.25
    damage 1.1
}
